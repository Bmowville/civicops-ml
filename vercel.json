{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "git": {
    "deploymentEnabled": {"**": false, "production": true}
  },
  "installCommand": "uv pip install -r requirements-lock.txt && uv pip install --no-deps .",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,infra/**,docs/**,scripts/**,.github/**,.azure/**,.venv/**,var/**,data/**}"
    }
  }
}
