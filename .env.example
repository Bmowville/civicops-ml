CIVICOPS_ENVIRONMENT=development
CIVICOPS_SESSION_SECRET=replace-with-at-least-32-random-characters
CIVICOPS_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
CIVICOPS_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
CIVICOPS_ENTRA_CERTIFICATE_PATH=var/entra/civicops-entra-private-key.pem
CIVICOPS_ENTRA_CERTIFICATE_THUMBPRINT=REPLACE_WITH_CERTIFICATE_THUMBPRINT
DATABASE_URL=postgresql://role:password@host/database?sslmode=require
CIVICOPS_AUTO_MIGRATE=true
CIVICOPS_LOGIN_LIMIT_PER_FIVE_MINUTES=10
CIVICOPS_MUTATION_LIMIT_PER_MINUTE=30
CIVICOPS_MONITORING_BASELINE_PATH=reports/monitoring_baseline.json
CIVICOPS_MONITORING_WINDOW_DAYS=30
CIVICOPS_MONITORING_INTERVAL_SECONDS=21600
# Production telemetry is enabled only when this is set by the hosting platform.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=civicops-ml
